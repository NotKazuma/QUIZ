    { "q": "ڤركاتاءن ايمبوهن دأول دان دأخير \"دڤر + كن\".", "o": ["دڤرچاياءي", "دڤرسمبهكن", "دڤرستوجوءي"], "a": 1, "e": "دڤر + سمبه + كن = دڤرسمبهكن." },
