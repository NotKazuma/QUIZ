    { "q": "استاذ عيديل مروڤاكن ___ جاوي نݢري جوهر.", "o": ["ڤرساتوان", "مماماءي", "ترسوس"], "a": 0, "e": "استاذ عيديل مروڤاكن ڤرساتوان جاوي نݢري جوهر." },
    { "q": "سرتياف موريد ڤرلو راجين اونتوق منداڤت ___ يڠ بهارو.", "o": ["منزيما", "ترووس", "علمو"], "a": 2, "e": "سرتياف موريد ڤرلو راجين منداڤت علمو يڠ بهارو." },
    { "q": "ايكور حروف \"ج\" ___ بنتوق ايكور حروف \"ع\".", "o": ["مماماءي", "ترووس", "منزيما"], "a": 0, "e": "ايكور ج مماماءي بنتوق ايكور ع." },
    { "q": "\"قض\" اداله چونتوه حروف اول برسامبوڠ ___.", "o": ["فرساتوان", "علمو", "تروس"], "a": 2, "e": "ق برسامبوڠ تروس كڤد ض." },
