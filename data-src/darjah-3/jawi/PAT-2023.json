    { "q": "كات داسر باݢي ڤركاتاءن \"ڤمبكر\".", "o": ["بكر", "ڤمبكر", "ممبكر"], "a": 0, "e": "ڤم + بكر = ڤمبكر." },
    { "q": "ايمبوهن دأخير \"ان\" (an).", "o": ["ماكنن", "ممباچ", "ڤلوكيس"], "a": 0, "e": "ماكن + ن = ماكنن." },
    { "q": "ايمبوهن دأول ڤركاتاءن \"ڤمباكرن\".", "o": ["ڤم", "مم", "بر"], "a": 0, "e": "ڤم + باكر + ن = ڤمباكرن." },
    { "q": "كات داسر باݢي ڤركاتاءن \"سأورڠ\".", "o": ["اورڠ", "سأور", "اور"], "a": 0, "e": "سـ + اورڠ = سأورڠ." },
