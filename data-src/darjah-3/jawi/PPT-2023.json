  "questions": [
    { "q": "ايمبوهن دأول ڤركاتاءن \"ويرا\".", "o": ["بر", "فر", "تر"], "a": 0, "e": "بر + ويرا = برويرا." },
    { "q": "ايمبوهن دأول \"م\".", "o": ["ملاراڠ", "ممباكر", "ممبري"], "a": 2, "e": "م + بري = ممبري." },
    { "q": "چونتوه ڤركاتاءن ايمبوهن دأول \"ف\".", "o": ["ڤمباكر", "ڤڠݢالي", "ڤنوليس"], "a": 0, "e": "ف + باكر = ڤمباكر." },
    { "q": "ايمبوهن دأخير.", "o": ["ءي", "ک", "بر"], "a": 0, "e": "چونتوه ايمبوهن دأخير اياله ءي." },
    { "q": "كيت ڤرلو ___ ڤراتورن جالن راي.", "o": ["ملينداوڠي", "مماتوهي", "مراساءي"], "a": 1, "e": "كيت ڤرلو مماتوهي ڤراتورن جالن راي." },
    { "q": "ايبو ممباهاس رومه.", "o": ["بتول", "ساله"], "a": 0, "e": "ايات اين بتول." },
