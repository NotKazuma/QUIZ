    { "q": "ايمبوهن دأخير يڠ سسواي دڠن ڤركاتاءن \"بنتو\" اياله \"ان\".", "o": ["بتول", "ساله"], "a": 0, "e": "بنتو + ان = بنتوان." },
    { "q": "\"برايتفتن\" اداله ڤركاتاءن برايمبوهن دأول دان دأخير.", "o": ["بتول", "ساله"], "a": 0, "e": "بر + ايتفت + ن = برايتفتن." },
    { "q": "كات داسر باݢي \"ڤمباكران\" اياله \"باكر\".", "o": ["بتول", "ساله"], "a": 0, "e": "ڤم + باكر + ن = ڤمباكران." },
    { "q": "ايمبوهن دأول ڤركاتاءن \"برورنا\".", "o": ["بر", "بران", "برسيه"], "a": 0, "e": "بر + ورنا = برورنا." },
    { "q": "ڤركاتاءن ايمبوهن دأول \"س\".", "o": ["سأورڠ", "سلامت", "سأورڠ"], "a": 0, "e": "سـ + اورڠ = سأورڠ." },
    { "q": "ايمبوهن دأخير يڠ سسواي دڠن \"امبيل\".", "o": ["كن", "مم", "تر"], "a": 0, "e": "امبيل + كن = امبيلكن." },
    { "q": "ايمبوهن دأول دان دأخير باݢي \"دڤر\" + \"ءي\".", "o": ["كاجياءن", "دڤركاجياءي", "ڤركاجي"], "a": 1, "e": "دڤر + كاجي + ءي = دڤركاجياءي." },
    { "q": "ڤوكوق ممبري اءير \"لالو\" اكرڽ.", "o": ["دلاكوكن", "ملاواوءي", "مالوءي"], "a": 0, "e": "اين اياله ڤتاره: دلاكوكن اكرڽ." },
    { "q": "\"د\" اداله چونتوه ايمبوهن دأول ڤركاتاءن ___.", "o": ["دأول", "سسل", "مي"], "a": 0, "e": "د + اول = دأول." },
    { "q": "ايمبوهن دأول ڤركاتاءن \"مبري\".", "o": ["مي", "دأول", "سسل"], "a": 0, "e": "مي + مبري = ميمبري." },
    { "q": "ايمبوهن دأخير باچي فركاتاءن \"توموان\".", "o": ["سسل", "دأول", "مي"], "a": 0, "e": "تومو + ان = توموان (سسل)." },
    { "q": "ايمبوهن دأول دان دأخير باݢي \"بر\" + \"ن\".", "o": ["برسامأن", "دأول", "مي"], "a": 0, "e": "بر + سام + ن = برسامأن." },
    { "q": "كات داسر باݢي ڤركاتاءن \"ڤيسلن\".", "o": ["ڤيسلن", "دأول", "مي"], "a": 0, "e": "ڤيسلن اياله كات داسر (ف + ايسلن)." },
    { "q": "ايمبوهن دأول ڤركاتاءن \"تر\".", "o": ["تربڠ", "دأول", "دأخير"], "a": 0, "e": "تر + بڠ = تربڠ." },
    { "q": "ايمبوهن دأول ڤركاتاءن \"ڤنجوال\".", "o": ["ڤن", "ڤرد", "مي"], "a": 0, "e": "ڤن + جوال = ڤنجوال." },
    { "q": "كات داسر باݢي ڤركاتاءن \"ماسقن\".", "o": ["ماسق", "دأول", "مي"], "a": 0, "e": "ماسق + ن = ماسقن." },
    { "q": "ايمبوهن دأول دان دأخير باݢي \"ک\" + \"ءن\".", "o": ["كأداءن", "دأول", "مي"], "a": 0, "e": "ک + ادا + ءن = كأداءن." },
    { "q": "خط اياله سني تولين يڠ اند دالم توليسن جاوي.", "o": ["بتول", "ساله"], "a": 0, "e": "ايات اين بتول." }
