    { "q": "اڤاكه ايمبوهن دأول باكي ڤركاتاءن \"اوليه\"؟", "o": ["دڤر", "ڤڤ", "ك"], "a": 0, "e": "دڤر + اوليه = دڤراوليه (diperoleh): ايمبوهن دأول اياله \"دڤر\"." },
    { "q": "ايمبوهن دأول ڤركاتاءن \"دوا\" اياله", "o": ["م", "ك", "ڤ"], "a": 1, "e": "ك + دوا = كدوا (kedua): ايمبوهن دأول اياله \"ك\"." },
    { "q": "ايمبوهن دأول باكي ڤركاتاءن \"باوا\"؟", "o": ["بر", "مم", "من"], "a": 1, "e": "مم + باوا = ممباوا (membawa): ايمبوهن دأول اياله \"مم\"." },
    { "q": "اڤاكه ايمبوهن دأول باكي ڤركاتاءن \"داڤت\"؟", "o": ["من", "ڤر", "ڤم"], "a": 0, "e": "من + داڤت = منداڤت (mendapat): ايمبوهن دأول اياله \"من\"." },

    { "q": "ڤچهن كاتا \"منلن\" اياله", "o": ["م + تلن", "مم + تلن", "من + تلن"], "a": 2, "e": "من + تلن = منلن (menelan)." },
    { "q": "ڤچهن كاتا \"ممبري\" اياله", "o": ["م + بري", "مم + بري", "من + بري"], "a": 1, "e": "مم + بري = ممبري (memberi)." },
    { "q": "ڤچهن كاتا \"مڠلڤ\" اياله", "o": ["مڤ + لڤ", "مڠ + لڤ", "مڤ + لاڤ"], "a": 1, "e": "مڠ + لڤ = مڠلڤ (mengelap)." },
    { "q": "ڤچهن كاتا \"ممڤربسر\" اياله", "o": ["م + بسر", "مم + بسر", "مم + ڤر + بسر"], "a": 2, "e": "مم + ڤر + بسر = ممڤربسر (memperbesar)." },
    { "q": "ڤچهن كاتا \"ڤنوليس\" اياله", "o": ["ڤنتو + ليس", "ڤن + توليس", "ڤ + نو + ليس"], "a": 1, "e": "ڤن + توليس = ڤنوليس (penulis)." },

    { "q": "PENJUAL = ڤن + جوال", "o": ["بتول", "ساله"], "a": 0, "e": "بتول، ڤن + جوال = ڤنجوال (penjual)." },
    { "q": "PENGECAT = ڤڠ + چت", "o": ["بتول", "ساله"], "a": 0, "e": "بتول، ڤڠ + چت = ڤڠچت (pengecat)." },
    { "q": "BACAAN = با + چا + ءن", "o": ["بتول", "ساله"], "a": 0, "e": "بتول، با + چا + ءن = باچاءن (bacaan)." },
    { "q": "BERTUJUAN = بر + توجو + ان", "o": ["بتول", "ساله"], "a": 0, "e": "بتول، بر + توجو + ان = برتوجوان (bertujuan)." },
    { "q": "KEADAAN = ك + اد + ءن", "o": ["بتول", "ساله"], "a": 0, "e": "بتول، ك + اد + ءن = كأداءن (keadaan)." }
