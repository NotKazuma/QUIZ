rules_version = '2';

// Peraturan Firestore untuk Kuiz Ulang Kaji.
// Salin SEMUA isi fail ini ke Firebase Console → Firestore Database → Rules, kemudian tekan Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Emel yang disahkan Google (token tetamu tiada emel, jadi guna get() dengan nilai lalai).
    function verifiedEmail() {
      return signedIn() && request.auth.token.get('email_verified', false) == true
        ? request.auth.token.get('email', '').lower()
        : '';
    }

    // Admin = akaun Google ini sahaja (mesti sama dengan src/lib/roles.js).
    function isAdmin() {
      return verifiedEmail() in ['aimanskspp@gmail.com'];
    }

    // Cikgu = (1) akaun DELIMa guru g-…@moe-dl.edu.my (automatik), atau
    //         (2) peranan 'teacher' yang diluluskan admin dalam dokumen pengguna.
    function isDelimaTeacher() {
      return verifiedEmail().matches('^g-[^@]+@moe-dl[.]edu[.]my$');
    }
    function isTeacher() {
      return isDelimaTeacher()
        || (signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null) == 'teacher');
    }
    function canTeach() {
      return isAdmin() || isTeacher();
    }
    function classData(cid) {
      return get(/databases/$(database)/documents/classes/$(cid)).data;
    }
    function ownsClass(cid) {
      return signedIn() && classData(cid).teacherUid == request.auth.uid;
    }
    function isMember(cid) {
      return signedIn() && exists(/databases/$(database)/documents/classes/$(cid)/members/$(request.auth.uid));
    }

    // ---- Avatar: hanya barang percuma atau yang ada dalam dompet pelayan (wallets/{uid}) boleh dipakai.
    // Barang percuma (harga 0) — mesti sama dengan src/lib/shop.js.
    function freeItems() {
      return ['harimau', 'kucing', 'songkok', 'latar-langit',
        'tema-oren', 'tema-hijau', 'tema-biru', 'tema-ungu', 'tema-merah', 'tema-kuning'];
    }
    function walletItems(uid) {
      let path = /databases/$(database)/documents/wallets/$(uid);
      return exists(path) ? get(path).data.get('items', []) : [];
    }
    function slotOk(av, slot, owned) {
      let v = av.get(slot, null);
      return v == null || v in freeItems() || v in owned;
    }
    function avatarOk(uid, av) {
      let owned = walletItems(uid);
      return av == null || (av is map
        && slotOk(av, 'animal', owned) && slotOk(av, 'hat', owned) && slotOk(av, 'glasses', owned)
        && slotOk(av, 'outfit', owned) && slotOk(av, 'shoes', owned) && slotOk(av, 'hand', owned)
        && slotOk(av, 'background', owned) && slotOk(av, 'frame', owned) && slotOk(av, 'card', owned));
    }
    // Tulisan ini tidak mengubah avatar, atau avatar baharu sah.
    function lookOk(uid) {
      let next = request.resource.data.get('avatar', null);
      return isAdmin()
        || (resource != null && resource.data.get('avatar', null) == next)
        || avatarOk(uid, next);
    }

    // Data pengguna: users/{uid}. Pengguna urus dokumen sendiri, tetapi tidak boleh ubah `role`.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && !('role' in request.resource.data) && lookOk(uid);
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
            && lookOk(uid));
      allow delete: if isAdmin();
    }

    // Soalan yang disunting admin: subjects/{exam}__{subjek}. Semua boleh baca, admin sahaja boleh ubah.
    match /subjects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Kelas: cikgu pemilik urus segalanya; murid (ahli) boleh baca kelas & kerja rumah.
    match /classes/{cid} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.teacherUid == request.auth.uid)
        || isMember(cid);
      allow create: if canTeach() && request.resource.data.teacherUid == request.auth.uid;
      allow update: if (ownsClass(cid) && request.resource.data.teacherUid == request.auth.uid) || isAdmin();
      allow delete: if ownsClass(cid) || isAdmin();

      // Murid menyertai dengan menyertakan kod kelas yang betul.
      match /members/{uid} {
        // Ahli kelas boleh melihat senarai kawan sekelas.
        allow read: if ownsClass(cid) || isAdmin() || (signedIn() && request.auth.uid == uid) || isMember(cid);
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.code == classData(cid).code;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.code == resource.data.code;
        allow delete: if ownsClass(cid) || isAdmin() || (signedIn() && request.auth.uid == uid);
      }

      match /assignments/{aid} {
        allow read: if ownsClass(cid) || isAdmin() || isMember(cid);
        allow write: if ownsClass(cid) || isAdmin();

        match /submissions/{uid} {
          allow read: if ownsClass(cid) || isAdmin() || (signedIn() && request.auth.uid == uid);
          allow create, update: if signedIn() && request.auth.uid == uid && isMember(cid);
          allow delete: if ownsClass(cid) || isAdmin();
        }
      }
    }

    // Set soalan cikgu (berasingan daripada bank rasmi). Pemilik & admin sahaja.
    // Murid menerima salinan soalan melalui kerja rumah / perlumbaan, bukan terus dari sini.
    match /teacherSets/{sid} {
      // get dibenarkan untuk sesiapa yang log masuk supaya pautan kongsi set boleh dibuka;
      // list (senarai semua set) hanya untuk pemilik atau admin.
      allow get: if signedIn();
      allow list: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if canTeach() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);

      // Keputusan murid yang menjawab pautan kongsi.
      match /attempts/{uid} {
        // Murid menulis rekod sendiri — hanya jika pautan set sedang DIBUKA (elak orang luar bila ditutup).
        allow write: if signedIn() && uid == request.auth.uid
          && get(/databases/$(database)/documents/teacherSets/$(sid)).data.get('shareOpen', true) == true;
        allow read: if isAdmin()
          || (signedIn()
              && get(/databases/$(database)/documents/teacherSets/$(sid)).data.ownerUid == request.auth.uid);
      }
    }

    // Bilik latihan (soalan bank rasmi, awam & boleh jejak). Pemilik = cikgu/admin.
    match /rooms/{rid} {
      allow get: if signedIn();                               // pautan bilik boleh dibuka sesiapa
      allow list: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if canTeach() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);

      match /attempts/{uid} {
        allow write: if signedIn() && uid == request.auth.uid
          && get(/databases/$(database)/documents/rooms/$(rid)).data.get('open', true) == true;
        allow read: if isAdmin()
          || (signedIn() && get(/databases/$(database)/documents/rooms/$(rid)).data.ownerUid == request.auth.uid);
      }
    }

    // Profil awam: avatar, nama paparan, gelaran & statistik ringkas. Pengguna log masuk boleh baca; pemilik sahaja tulis.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && lookOk(uid);
      allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    // Dompet syiling/barang/kuasa: hanya dibaca oleh pemilik. Ditulis oleh Cloudflare Worker sahaja
    // (akaun servis melepasi peraturan ini), jadi pengguna tidak boleh menambah syiling sendiri.
    match /wallets/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // Kod kelas -> id kelas. Boleh dibaca satu-satu (bukan disenaraikan).
    match /classCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if canTeach() && ownsClass(request.resource.data.classId);
      allow delete: if signedIn() && (ownsClass(resource.data.classId) || isAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
