{
  "rules": {
    "races": {
      "$pin": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid)",
        ".validate": "!newData.exists() || newData.hasChildren(['hostUid', 'status'])",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().exists() && (data.exists() || data.parent().parent().child('status').val() !== 'ended')",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 30 && newData.child('score').isNumber())"
          }
        }
      }
    },
    "games": {
      "$pin": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid)",
        ".validate": "!newData.exists() || newData.hasChildren(['hostUid', 'status', 'type'])",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().exists()",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 30)"
          }
        },
        "state": {
          ".write": "auth != null && data.parent().child('players').child(auth.uid).exists() && data.parent().child('status').val() === 'playing'"
        },
        "status": {
          ".write": "auth != null && data.parent().child('players').child(auth.uid).exists() && data.val() === 'playing' && newData.val() === 'ended'"
        }
      }
    }
  }
}
